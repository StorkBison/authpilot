# Copy to .env. Everything is optional - the app runs fully offline with defaults.

# Claude drives the agent when a key is set; otherwise the offline rule-based planner runs.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AGENT_MAX_STEPS=30

# FHIR source: "local" serves the synthetic bundles in data/fhir; set FHIR_BASE_URL to use a
# real FHIR R4 server (e.g. a HAPI FHIR instance loaded with the same bundles).
FHIR_BASE_URL=

# Simulated payer: how many status checks before a pending request is decided.
PAYER_DECISION_AFTER_CHECKS=1

# Defaults to sqlite:///./var/authpilot.db (or /tmp on Vercel). Use Postgres in production,
# e.g. the DATABASE_URL Neon adds on Vercel.
DATABASE_URL=

# Public demo protection: max agent runs per rolling hour (0 = unlimited).
MAX_AGENT_RUNS_PER_HOUR=0
